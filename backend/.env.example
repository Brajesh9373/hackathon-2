# ============================================================
# NagarSetu Backend - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5001

# MongoDB Connection
# Local:  mongodb://localhost:27017/nagarsetu
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net/nagarsetu
MONGODB_URI=mongodb://localhost:27017/nagarsetu

# JWT Secrets — use strong random strings in production!
JWT_SECRET=nagarsetu-jwt-secret-change-in-production
REFRESH_TOKEN_SECRET=nagarsetu-refresh-secret-change-in-production

# Demo Mode — enables OTP bypass (OTP: 123456)
# Set to false in production
DEMO_MODE=true

# Cloudinary — for image uploads (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis — for Bull job queues (optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379

# Vapi voice calls (server key never goes to the browser)
VAPI_SERVER_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4.1

# Optional Make.com orchestration. Direct Vapi remains the local fallback.
MAKE_WORK_DONE_WEBHOOK_URL=
MAKE_API_TOKEN=
CIVIC_CALLBACK_TOKEN=
PUBLIC_CALLBACK_URL=http://localhost:5001

# Keep the default register empty. Set true only when you explicitly want fixtures.
SEED_SAMPLE_DATA=false
